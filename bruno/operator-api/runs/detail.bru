meta {
  name: Run detail
  type: http
  seq: 3
}
get {
  url: {{baseUrl}}/v1/runs/{{runId}}
  body: none
  auth: awsv4
}
auth:awsv4 {
  accessKeyId: {{$processEnv AWS_ACCESS_KEY_ID}}
  secretAccessKey: {{$processEnv AWS_SECRET_ACCESS_KEY}}
  sessionToken: {{$processEnv AWS_SESSION_TOKEN}}
  service: execute-api
  region: {{region}}
}
