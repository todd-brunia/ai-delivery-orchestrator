meta {
  name: Create run
  type: http
  seq: 1
}
post {
  url: {{baseUrl}}/v1/runs
  body: json
  auth: awsv4
}
auth:awsv4 {
  accessKeyId: {{$processEnv AWS_ACCESS_KEY_ID}}
  secretAccessKey: {{$processEnv AWS_SECRET_ACCESS_KEY}}
  sessionToken: {{$processEnv AWS_SESSION_TOKEN}}
  service: execute-api
  region: {{region}}
}
headers {
  Idempotency-Key: bruno:create:replace-me
}
body:json {
  { "apiVersion": "operator-api/v1", "run": { "workflowVersion": "sprint-delivery/v1", "repository": "owner/repository", "issueNumbers": [1], "mergePolicy": "human" } }
}
