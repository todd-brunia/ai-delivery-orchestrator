meta {
  name: Reconcile run
  type: http
  seq: 8
}
post {
  url: {{baseUrl}}/v1/runs/{{runId}}/reconcile
  body: json
  auth: awsv4
}
auth:awsv4 {
  accessKeyId: {{$processEnv AWS_ACCESS_KEY_ID}}
  secretAccessKey: {{$processEnv AWS_SECRET_ACCESS_KEY}}
  sessionToken: {{$processEnv AWS_SESSION_TOKEN}}
  service: execute-api
  region: {{region}}
}
headers {
  Idempotency-Key: bruno:reconcile:replace-me
}
body:json { { "apiVersion": "operator-api/v1", "expectedRevision": 0, "reason": "operator request" } }
