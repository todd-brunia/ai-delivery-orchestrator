{
  "name": "ai-delivery-orchestrator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "docker:build": "docker build --tag ai-delivery-orchestrator:local .",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "tsx src/persistence/migrate-cli.ts",
    "db:checkpoints": "tsx src/workflows/checkpoint-setup-cli.ts",
    "dry-run:schedule": "tsx src/workflows/dry-run-cli.ts",
    "start": "node dist/index.js",
    "test": "vitest run --coverage test/*.test.ts",
    "test:integration": "vitest run --no-file-parallelism test/integration",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1108.0",
    "@aws-sdk/client-secrets-manager": "^3.1108.0",
    "@aws-sdk/client-sqs": "^3.1108.0",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.4",
    "aws-lambda-ric": "^4.0.2",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
